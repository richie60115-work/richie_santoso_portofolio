    });

    // ── Laba Rugi ──────────────────────────────────────────────────────────────
    Route::prefix('laba-rugi')->name('labarugi.')->group(function () {
        Route::get('/',              [App\Http\Controllers\Manajer\LabaRugiController::class, 'index'])
            ->name('index');
        Route::get('/order/{order}', [App\Http\Controllers\Manajer\LabaRugiController::class, 'orderDetail'])
            ->name('order');
        // Route::get('/api/order/{order}',  [App\Http\Controllers\Manajer\LabaRugiController::class, 'orderApi'])
        //     ->name('api.order');
        // Route::get('/order/{order}', [LabaRugiController::class, 'orderDetail'])  // <-- fix: showOrder → orderDetail
        // ->name('order');
    Route::get('/api/hutang',    [LabaRugiController::class, 'apiHutang'])    // <-- fix: hutangApi → apiHutang
        ->name('api.hutang');
            // Route::get('/api/periode',        [App\Http\Controllers\Manajer\LabaRugiController::class, 'periodeApi'])
