        Route::post('/{product}/toggle', [App\Http\Controllers\Manajer\ProductController::class, 'toggleActive'])
            ->name('toggle');

        // Variants
        Route::post('/{product}/variants',              [App\Http\Controllers\Manajer\ProductController::class, 'storeVariant'])
            ->name('variants.store');
        Route::put('/{product}/variants/{variant}',     [App\Http\Controllers\Manajer\ProductController::class, 'updateVariant'])
            ->name('variants.update');
        Route::delete('/{product}/variants/{variant}',  [App\Http\Controllers\Manajer\ProductController::class, 'destroyVariant'])
            ->name('variants.destroy');

        // Formulas
        Route::post('/{product}/formulas',              [App\Http\Controllers\Manajer\ProductController::class, 'storeFormula'])
    ->name('formulas.store');
Route::put('/{product}/formulas/{formula}',     [App\Http\Controllers\Manajer\ProductController::class, 'updateFormula'])
    ->name('formulas.update');
Route::delete('/{product}/formulas/{formula}',  [App\Http\Controllers\Manajer\ProductController::class, 'destroyFormula'])
    ->name('formulas.destroy');

        // Colors
        Route::post('/colors',         [App\Http\Controllers\Manajer\ProductController::class, 'storeColor'])
            ->name('colors.store');
        Route::put('/colors/{color}',  [App\Http\Controllers\Manajer\ProductController::class, 'updateColor'])
            ->name('colors.update');
        Route::delete('/colors/{color}', [App\Http\Controllers\Manajer\ProductController::class, 'destroyColor'])
            ->name('colors.destroy');

        // API
        Route::get('/{product}/variants-api', [App\Http\Controllers\Manajer\ProductController::class, 'variantsApi'])
