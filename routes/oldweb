    // ── Bahan Baku ─────────────────────────────────────────────────────────────
    Route::prefix('bahan-baku')->name('bahan-baku.')->group(function () {
        Route::get('/',         [App\Http\Controllers\Manajer\RawMaterialController::class, 'index'])
            ->name('index');
        Route::post('/',        [App\Http\Controllers\Manajer\RawMaterialController::class, 'store'])
            ->name('store');
